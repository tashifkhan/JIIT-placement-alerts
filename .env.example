# MongoDB
MONGO_CONNECTION_STR=mongodb+srv://username:password@cluster.example/database
MONGO_DATABASE_NAME=2025-26
GLOBAL_DATABASE_NAME=PlacementBotGlobal
ACTIVE_PLACEMENT_YEAR=202526
DEFAULT_PLACEMENT_YEAR=202526
PLACEMENT_YEARS=["202526", "202627"]

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=replace-with-default-chat-id
ADMIN_TELEGRAM_USER_IDS=[123456789]

# SuperSet. The update command scrapes every key in this per-year map.
# PLACEMENT_YEARS alone does not enable SuperSet ingestion for a year.
SUPERSET_CREDENTIALS=[]
SUPERSET_CREDENTIALS_BY_YEAR={"202526": [{"email": "senior@example.com", "password": "replace-me"}], "202627": [{"email": "junior@example.com", "password": "replace-me"}]}

# LLM and placement mailbox
GOOGLE_API_KEY=replace-with-google-api-key
LLM_MODEL=gemini-3.8-flash
LLM_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LIKELY_ON_CAMPUS_MIN_CONFIDENCE=0.70
PLACEMENT_EMAIL=placement@example.com
PLACEMENT_APP_PASSWORD=replace-with-app-password

# Webhook API. Generate a long random value and send it in X-API-Key.
WEBHOOK_API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=["https://your-dashboard.example.com"]
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8000

# Web Push
VAPID_PRIVATE_KEY=replace-with-private-key
VAPID_PUBLIC_KEY=replace-with-public-key
VAPID_EMAIL=admin@example.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/superset_bot.log
SCHEDULER_LOG_FILE=logs/scheduler.log
